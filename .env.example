# Supabase — browser uploads SVGs directly to Supabase Storage on submit
VITE_DATABASE_URL=https://your-project.supabase.co
VITE_DATABASE_KEY=your-supabase-anon-key

# GitHub — browser fires repository_dispatch directly to trigger the GitHub Action
# Generate at: https://github.com/settings/tokens → Classic → check 'repo' + 'workflow'
# Add this same value to Cloudflare Pages environment variables
VITE_GH_PAT=ghp_your_personal_access_token
VITE_GH_OWNER=syed-sameer-ul-hassan1
VITE_GH_REPO=SVG-IO
