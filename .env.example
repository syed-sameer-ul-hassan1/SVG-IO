# ── Supabase ────────────────────────────────────────────────────────────────
# Used by the frontend (Vite) and Cloudflare Pages Function
VITE_DATABASE_URL=https://your-project.supabase.co
VITE_DATABASE_KEY=your-supabase-anon-key

# Used server-side by the Cloudflare Pages Function (/api/submit-icon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope
# Generate at: https://github.com/settings/tokens?type=beta
# Add to BOTH Cloudflare Pages env vars AND GitHub repo secrets
GH_PAT=ghp_your_personal_access_token

# GitHub repo info (used by the Pages Function to trigger repository_dispatch)
GH_OWNER=syed-sameer-ul-hassan1
GH_REPO=SVG-IO
